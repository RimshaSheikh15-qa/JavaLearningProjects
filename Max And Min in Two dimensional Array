		//This is a program to find the Minimum number in a two dimentional array.

		
		int min=1000;
		int c[][]= {{1,3,4},{4,56,0},{90,21,-1}};
		for (int d=0; d<3;d++) {
			for (int k=0; k<3;k++)
			{
				if(c[d][k]<min) {
					min=c[d][k];
				}
			}
			
		}System.out.println("The Minimum number is");
