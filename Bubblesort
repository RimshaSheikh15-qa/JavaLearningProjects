package firstproject;

public class bubblesort {

    public static void main(String[] args) {
        int a[] = {1, 2, 8, 0, 12, 45, 61, 23, 1, 3, 4};
        int temp = 0;
        
        // Outer loop for the number of passes (array length - 1)
        for (int i = 0; i < a.length - 1; i++) {  // Notice the length - 1 here
            // Inner loop for comparing adjacent elements
            for (int j = 0; j < a.length - 1 - i; j++) {  // Decrease range after each pass
                if (a[j] >a[j + 1]) {  // Swap if the current element is greater than the next
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }
            }
        }
        
        // Print the sorted array
        for (int j = 0; j < a.length; j++) {
            System.out.println(a[j]);
        }
    }
}
